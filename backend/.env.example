# Umax RAG 后端环境配置模板
# 用法：复制本文件为 backend/.env（或直接补齐进现有 .env），填完占位符后重启后端。
# 字段来源：backend/app/core/config.py（大小写不敏感，环境变量优先于 .env）
# ⚠️ backend/.env 已被 .gitignore 排除，切勿把真实密钥提交入库。

# ---- 必填：百炼 API（聊天/向量/重排三场景共用）----
DASHSCOPE_API_KEY=sk-在这里填你的百炼Key

# ---- 阶段 2 播种首个管理员（ADMIN_TOKEN 方案已退役）----
# 后端启动时若 users 表为空，按下面两项播种 role=admin 的首个账号（口令 scrypt 哈希入库，明文永不落库），
# 并打 WARNING 日志提示「部署后立即登录改密」。留空则播种内置默认账号 admin@umax.local/默认口令（仅应急，起服即告警）。
# 生成强口令建议：python -c "import secrets;print(secrets.token_urlsafe(16))"  或 openssl rand -base64 18
# 播种只在空表时发生，之后改密/加用户在 /admin/users 管理，不再读这两项。
ADMIN_EMAIL=admin@umax.local
ADMIN_PASSWORD=在这里填一段无意义强口令（至少 8 位，与后端 new_password min_length=8 对齐）

# ---- 必填（要用模型登记页时）：模型网关主密钥 ----
# 用于 Fernet 加密 model_configs.encrypted_api_key；未配置时 POST /api/v1/models 一律 503。
# 生成方式（任选其一，结果填等号右侧，勿带引号）：
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"
GATEWAY_SECRET=在这里填32字节十六进制随机串

# ---- 可选：PostgreSQL（默认值即 docker compose 的 umaxrag-pg，无需改）----
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=rag
# PG_PASSWORD=rag_dev_2026
# PG_DB=umaxrag

# ---- 可选：百炼端点与模型名（默认值见 config.py，一般不用动）----
# DASHSCOPE_COMPAT_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_NATIVE_BASE=https://dashscope.aliyuncs.com/api/v1
# CHAT_MODEL=qwen3.7-flash
# EMBEDDING_MODEL=qwen3.7-text-embedding
# RERANK_MODEL=qwen3.7-text-rerank
# EMBEDDING_DIM=1024

# ---- 可选：本地兜底模型（不配百炼时离线跑通用层）----
# EMBED_PROVIDER=local
# LOCAL_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# LOCAL_RERANK_MODEL=BAAI/bge-reranker-base

# ---- 可选：扫描件解析（MinerU 服务，留空=禁用，上传扫描件会明确报错）----
# MINERU_BASE_URL=http://localhost:8886

# ---- 可选：入库调度（sync=开发默认同步跑；arq=生产异步，需 Redis 容器）----
# QUEUE_BACKEND=sync
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ---- 可选：切块与检索参数（默认值见 config.py）----
# CHUNK_TARGET=300
# CHUNK_MIN=60
# RECALL_K=10
# RERANK_TOP_N=5
# MIN_SIM=0.15
