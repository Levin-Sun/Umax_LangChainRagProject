# Umax RAG 一键交付环境模板（docker compose 用）
# 用法：cp .env.example .env，填完下面必填项后：docker compose up -d --build
# ⚠️ .env 含密钥，已被 .gitignore 排除，切勿提交或外发。

# ---- 必填：初始管理员（后端首启 users 空表时播种；首次登录会强制改密）----
# 生成强口令：python -c "import secrets;print(secrets.token_urlsafe(16))" 或 openssl rand -base64 18
ADMIN_EMAIL=admin@umax.local
ADMIN_PASSWORD=在这里填一段无意义强口令（至少 8 位）

# ---- 必填：模型网关主密钥（Fernet 加密 model_configs.encrypted_api_key）----
# 不配则服务可跑，但 /admin/models 登记模型一律 503。
# 生成方式：openssl rand -hex 32
GATEWAY_SECRET=

# ---- 模型 key（二选一：这里填百炼 key，或部署后到 /admin/models 页面登记，推荐后者）----
DASHSCOPE_API_KEY=

# ---- 可选：端口（默认即 5432/8000/3000，端口被占再改）----
# PG_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=3000

# ---- 可选：PostgreSQL 凭据（默认值即可，改了会同步到 PG 容器初始化）----
# PG_USER=rag
# PG_PASSWORD=rag_dev_2026
# PG_DB=umaxrag

# ---- 可选：License 授权（§D：授权文件控制到期时间、绑定客户机器）----
# 1) 部署后在「管理后台 → 授权」页复制机器指纹，发给服务商
# 2) 服务商签发 license.json，放到部署根目录
# 3) 填下面两项并重启
# MACHINE_FINGERPRINT=交付时固定（必须显式设置：容器重建会让 machine-id 变化致授权失效）
# LICENSE_PUBLIC_KEY=服务商下发的公钥
# LICENSE_FILE=/app/license.json   # 容器内路径，compose 已挂载 ./license.json → /app/license.json

# ---- 可选：入库调度（sync=同步，默认；arq=异步，需 --profile arq 启动 redis+worker）----
# QUEUE_BACKEND=arq

# ---- 可选：扫描件解析 MinerU 服务地址（留空=禁用，上传扫描件会明确报错）----
# MINERU_BASE_URL=http://mineru:8886

# —— 以下为后台可改项（部署后管理页配置，不需要写进 .env）——
# 模型登记/启停：/admin/models（分场景 chat/embedding/rerank/vision，BYO-key 加密存储）
# 用户与库级授权：/admin/users；审计：/admin/audit
