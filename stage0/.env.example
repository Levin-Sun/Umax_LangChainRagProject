# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，不要提交
DASHSCOPE_API_KEY=sk-xxxx

# 阿里云百炼专属端点（工作空间 key 仅放行部分模型，详见需求文档 §6.3；公共端点可留空用默认值）
# DASHSCOPE_COMPAT_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_NATIVE_BASE=https://dashscope.aliyuncs.com/api/v1

# 模型选择（当前实测：专属端点仅放行 qwen3.7-flash；embedding/rerank 放行后可切回 API）
CHAT_MODEL=qwen3.7-flash
# EMBEDDING_MODEL=qwen3.7-text-embedding
# EMBEDDING_DIM=1024
# RERANK_MODEL=qwen3.7-text-rerank

# 嵌入提供方：bailian（API）/ local（本机 sentence-transformers，当前生效）
# 注意：切换 embedding 模型 = 全部向量失效，须重跑 ingest.py 重新入库
EMBED_PROVIDER=local
LOCAL_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# 本地重排（CrossEncoder），注释掉则不用本地重排
LOCAL_RERANK_MODEL=BAAI/bge-reranker-base
# 本地模型下载走 HuggingFace 镜像（国内网络）
# HF_ENDPOINT=https://hf-mirror.com

# PostgreSQL（docker-compose 已起 pgvector:pg16）
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=rag
# PG_PASSWORD=rag_dev_2026
# PG_DB=umaxrag
